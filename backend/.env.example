# Copie para backend/.env e preencha. Nunca versione o .env.

# Obrigatório em produção. Em desenvolvimento (DEBUG=True) há um fallback inseguro.
# Gere um novo com: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

DEBUG=True

# Listas separadas por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Cloudflare R2 (mídia). Sem R2_BUCKET, os uploads vão para backend/media/.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_DOMAIN=

# E-mail (usado só na recuperação de senha).
# Em desenvolvimento (DEBUG=True) as mensagens saem no console; em produção é preciso SMTP.
# Deixe em branco para usar o padrão (console em dev, SMTP em produção).
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Clubi <nao-responda@clubi.local>
